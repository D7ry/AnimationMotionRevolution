{
  "version": 3,
  "configurePresets": [
    {
      "name": "release-se-ae",
      "displayName": "Release - Skyrim SE and AE",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../AnimationMotionRevolution-build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-md",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "ENABLE_SKYRIM_SE": "ON",
        "ENABLE_SKYRIM_AE": "ON",
        "ENABLE_SKYRIM_VR": "OFF",
        "SKSE_SUPPORT_XBYAK": "ON",
        "SKSE_SUPPORT_PATCH_SAFETY": "ON",
        "BUILD_TESTS": "OFF",
        "COMMONLIB_PREBUILT": "OFF",
        "COMMONLIB_ENABLE_IPO": "OFF",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release-se-ae",
      "configurePreset": "release-se-ae",
      "jobs": 0
    }
  ]
}
